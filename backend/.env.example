APP_NAME=CognitiveProgress API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Database (SQLite by default, zero-config local file):
# DATABASE_URL=sqlite:///./cognitiveprogress.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cognitiveprogress
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
INGESTION_STORAGE_PATH=data/imports

# AI Providers:
# For offline deterministic demo (default, no API keys needed):
AI_TEXT_PROVIDER=deterministic_mock
AI_EMBEDDING_PROVIDER=deterministic_mock

# For real AI execution with Google Gemini and Sentence Transformers:
# AI_TEXT_PROVIDER=gemini
# AI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=your_gemini_api_key_here
# AI_EMBEDDING_PROVIDER=sentence_transformers
# AI_EMBEDDING_MODEL=all-MiniLM-L6-v2

AUTO_ACCEPT_CONFIDENCE_THRESHOLD=0.9
PLANNER_REVIEW_CONFIDENCE_THRESHOLD=0.6

MATCHING_HIGH_CONFIDENCE_THRESHOLD=0.70
MATCHING_AMBIGUOUS_SCORE_DELTA=0.08
MATCHING_NO_MATCH_THRESHOLD=0.45
MATCHING_CANDIDATE_LIMIT=10

RECONCILIATION_AUTO_ACCEPT_THRESHOLD=0.85
RECONCILIATION_REVIEW_THRESHOLD=0.50
RECONCILIATION_NO_DECISION_THRESHOLD=0.30
RECONCILIATION_FRESHNESS_HALF_LIFE_DAYS=14
RELIABILITY_DAILY_REPORT=0.90
RELIABILITY_CONTRACTOR_SPREADSHEET=0.75
RELIABILITY_DISCIPLINE_SPREADSHEET=0.80
RELIABILITY_SITE_DIARY=0.65
RELIABILITY_MANUAL_ENTRY=0.60
